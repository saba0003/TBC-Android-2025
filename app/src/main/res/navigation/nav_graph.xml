<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/configurationFragment">

    <fragment
        android:id="@+id/configurationFragment"
        android:name="com.example.tbc_android_2025.fragments.ConfigurationFragment"
        android:label="Configure Game">
        <action
            android:id="@+id/action_configurationFragment_to_gameFragment"
            app:destination="@id/gameFragment" />
    </fragment>

    <fragment
        android:id="@+id/gameFragment"
        android:name="com.example.tbc_android_2025.fragments.GameFragment"
        android:label="Game">
        <argument
            android:name="gridSize"
            app:argType="integer" />
    </fragment>

</navigation>
