<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.tbc_android_2025.presentation.screen.splash.SplashFragment"
        android:label="Splash Screen">
        <action
            android:id="@+id/action_splashFragment_to_cardsFragment"
            app:destination="@id/cardsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cardsFragment"
        android:name="com.example.tbc_android_2025.presentation.screen.cards.CardsFragment"
        android:label="Cards Screen" />

</navigation>
