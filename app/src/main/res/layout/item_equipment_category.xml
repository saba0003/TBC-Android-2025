<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/dot4View"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/dot_orange"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/dot3View"
        app:layout_constraintEnd_toStartOf="@id/dot3View"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/dot3View" />

    <View
        android:id="@+id/dot3View"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/dot_orange"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/dot2View"
        app:layout_constraintEnd_toStartOf="@id/dot2View"
        app:layout_constraintStart_toEndOf="@id/dot4View"
        app:layout_constraintTop_toTopOf="@id/dot2View" />

    <View
        android:id="@+id/dot2View"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/dot_orange"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/dot1View"
        app:layout_constraintEnd_toStartOf="@id/dot1View"
        app:layout_constraintStart_toEndOf="@id/dot3View"
        app:layout_constraintTop_toTopOf="@id/dot1View" />

    <View
        android:id="@+id/dot1View"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/dot_orange"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/categoryNameTextView"
        app:layout_constraintEnd_toStartOf="@id/categoryNameTextView"
        app:layout_constraintStart_toEndOf="@id/dot2View"
        app:layout_constraintTop_toTopOf="@id/categoryNameTextView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/categoryNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/category_name_sample"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="20dp"
        android:background="@color/gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryNameTextView" />

</androidx.constraintlayout.widget.ConstraintLayout>
