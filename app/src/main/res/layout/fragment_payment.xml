<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="49dp"
        android:background="@drawable/shape_oval"
        android:contentDescription="@string/back_button_label"
        android:elevation="2dp"
        android:minWidth="32dp"
        android:minHeight="32dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/paymentTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/payment"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/cardManagementTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/card_management"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/cardsViewPager"
        app:layout_constraintEnd_toStartOf="@id/addNewTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/addNewTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:text="@string/add_new"
        android:textColor="@color/amaranth"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/cardManagementTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardManagementTextView"
        app:layout_constraintTop_toTopOf="@id/cardManagementTextView" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/cardsViewPager"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:contentDescription="@string/list_of_cards_label"
        app:layout_constraintBottom_toTopOf="@id/orCheckOutWithTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardManagementTextView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/orCheckOutWithTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/or_check_out_with"
        app:layout_constraintBottom_toTopOf="@id/paymentMethodsConstraintLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardsViewPager" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paymentMethodsConstraintLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:contentDescription="@string/payment_methods_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orCheckOutWithTextView">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/paypalImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rounded_rectangle_for_credit_card_type_icons"
            android:contentDescription="@string/paypal_label"
            android:elevation="2dp"
            android:src="@drawable/ic_paypal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/visaImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/visaImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rounded_rectangle_for_credit_card_type_icons"
            android:contentDescription="@string/visa_label"
            android:elevation="2dp"
            android:src="@drawable/ic_visa"
            app:layout_constraintBottom_toBottomOf="@id/paypalImageView"
            app:layout_constraintEnd_toStartOf="@id/mastercardImageView"
            app:layout_constraintStart_toEndOf="@id/paypalImageView"
            app:layout_constraintTop_toTopOf="@id/paypalImageView" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/mastercardImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rounded_rectangle_for_credit_card_type_icons"
            android:contentDescription="@string/mastercard_label"
            android:elevation="2dp"
            android:src="@drawable/ic_mastercard"
            app:layout_constraintBottom_toBottomOf="@id/visaImageView"
            app:layout_constraintEnd_toStartOf="@id/alipayImageView"
            app:layout_constraintStart_toEndOf="@id/visaImageView"
            app:layout_constraintTop_toTopOf="@id/visaImageView" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/alipayImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rounded_rectangle_for_credit_card_type_icons"
            android:contentDescription="@string/alipay_label"
            android:elevation="2dp"
            android:src="@drawable/ic_alipay"
            app:layout_constraintBottom_toBottomOf="@id/mastercardImageView"
            app:layout_constraintEnd_toStartOf="@id/americanExpressImageView"
            app:layout_constraintStart_toEndOf="@id/mastercardImageView"
            app:layout_constraintTop_toTopOf="@id/mastercardImageView" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/americanExpressImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/medium_blue"
            android:contentDescription="@string/american_express_label"
            android:elevation="2dp"
            android:src="@drawable/ic_amex"
            app:layout_constraintBottom_toBottomOf="@id/alipayImageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/alipayImageView"
            app:layout_constraintTop_toTopOf="@id/alipayImageView" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
