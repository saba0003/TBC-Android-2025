<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/profilePhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:src="@mipmap/sample_image"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/fullNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:text="@string/sample_full_name"
        app:layout_constraintBottom_toTopOf="@id/lastMessageTextView"
        app:layout_constraintStart_toEndOf="@id/profilePhoto"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/lastMessageTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sample_last_message"
        app:layout_constraintBottom_toBottomOf="@id/profilePhoto"
        app:layout_constraintEnd_toEndOf="@+id/fullNameTextView"
        app:layout_constraintStart_toStartOf="@id/fullNameTextView"
        app:layout_constraintTop_toBottomOf="@id/fullNameTextView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/lastActiveTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:text="@string/sample_last_active_at"
        app:layout_constraintBottom_toBottomOf="@id/fullNameTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fullNameTextView"
        app:layout_constraintTop_toTopOf="@id/fullNameTextView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/numberOfUnreadMessagesTextView"
        android:layout_width="11dp"
        android:layout_height="14dp"
        android:text="@string/sample_number_of_missed_messages"
        app:layout_constraintBottom_toBottomOf="@id/lastMessageTextView"
        app:layout_constraintEnd_toEndOf="@id/lastActiveTextView"
        app:layout_constraintStart_toStartOf="@id/lastActiveTextView"
        app:layout_constraintTop_toTopOf="@id/lastMessageTextView" />

</androidx.constraintlayout.widget.ConstraintLayout>