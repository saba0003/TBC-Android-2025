<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TBCAndroid2025" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <!-- Base style for the numeric buttons -->
    <style name="KeypadButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:background">@drawable/bg_keypad_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:elevation">2dp</item> <!-- Shadow effect -->
    </style>

    <!-- Styles for the passcode dots -->
    <style name="PasscodeDot">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">12dp</item>
    </style>

    <style name="PasscodeDot.Filled" parent="PasscodeDot">
        <item name="android:background">@drawable/shape_dot_filled</item>
    </style>

    <style name="PasscodeDot.Empty" parent="PasscodeDot">
        <item name="android:background">@drawable/shape_dot_empty</item>
        <item name="android:layout_marginEnd">0dp</item> <!-- Last dot needs no margin -->
    </style>
</resources>
